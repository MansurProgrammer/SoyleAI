class VoiceWave(QWidget):
    def __init__(self):
        super().__init__()
        self.setMinimumHeight(40); self.samples = [0] * 60
    def update_wave(self, level):
        self.samples.pop(0); self.samples.append(level); self.update()
    def paintEvent(self, event):
        p = QPainter(self); p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w = self.width() / len(self.samples)
        for i, s in enumerate(self.samples):
            h = max(2, s * self.height() * 0.9)
            rect = QRectF(i * w, (self.height() - h) / 2, w - 2, h)
            p.fillRect(rect, QColor("#3B82F6"))

class CircularScore(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent); self.display_value = 0; self.setMinimumSize(220, 220)
    def set_score(self, val):
        self.display_value = val; self.update()
    def paintEvent(self, event):
        p = QPainter(self); p.setRenderHint(QPainter.RenderHint.Antialiasing)
        rect = QRectF(25, 25, 170, 170)
        p.setPen(QPen(QColor(40, 40, 45), 15)); p.drawEllipse(rect)
        if self.display_value < 50: color = QColor("#FF4B2B")
        elif self.display_value < 80: color = QColor("#FDC830")
        else: color = QColor("#00F260")
        pen = QPen(color, 15, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap)
        p.setPen(pen); p.drawArc(rect, 90 * 16, -int(self.display_value * 3.6 * 16))
        p.setPen(QColor("white")); p.setFont(QFont("Segoe UI Variable", 36, QFont.Weight.Bold))
        p.drawText(rect, Qt.AlignmentFlag.AlignCenter, f"{int(self.display_value)}%")

