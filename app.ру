    def audio_callback(self, indata, frames, time, status):
        v = np.linalg.norm(indata) * 10; self.current_vol = min(1.0, v)
        if self.is_recording: self.audio_data.extend(indata[:,0])

    def toggle_cam(self): self.camera_hidden = not self.camera_hidden

    def draw_ar_visuals(self, frame, pts, w, h):
        letter = self.box.currentText(); curr_d = abs(pts[13].y - pts[14].y)
        target_d = TARGET_MOUTH_OPENNESS.get(letter, 0.03); accuracy = max(0, 100 - abs(curr_d - target_d) * 1000)
        color = (0, 242, 96) if accuracy > 85 else (43, 75, 255)
        for idx in [61, 146, 91, 181, 84, 17, 314, 405, 321, 375, 291, 13, 14]:
            px, py = int(pts[idx].x * w), int(pts[idx].y * h); cv2.circle(frame, (px, py), 1, color, -1)

    def process_frame(self, frame):
        frame = cv2.flip(frame, 1); h_f, w_f, _ = frame.shape
        if self.camera_hidden: 
            frame[:] = 15
        else:
            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB); res = self.face_mesh.process(rgb)
            if res.multi_face_landmarks:
                pts = res.multi_face_landmarks[0].landmark; self.draw_ar_visuals(frame, pts, w_f, h_f)
                d = abs(pts[13].y - pts[14].y)
                if not self.is_recording: 
                    self.live_hint.setText("ЖАЗУДЫ БАСТАҢЫЗ")
                    self.live_hint.setStyleSheet("color: #555; background: #111; border-radius: 10px; padding: 5px;")
                elif d < TARGET_MOUTH_OPENNESS.get(self.box.currentText(), 0.03) - 0.01: 
                    self.live_hint.setText("АУЫЗДЫ КЕҢІРЕК АШЫҢЫЗ")
                    self.live_hint.setStyleSheet("color: #FDC830; background: #111; border-radius: 10px; padding: 5px;")
                else: 
                    self.live_hint.setText("КЕРЕМЕТ! ДЫБЫСТАҢЫЗ")
                    self.live_hint.setStyleSheet("color: #00F260; background: #111; border-radius: 10px; padding: 5px;")
                nose_x, nose_y = pts[1].x * w_f, pts[1].y * h_f; cx, cy, rx, ry = w_f // 2, h_f // 2, 140, 200
                color_oval = (0, 242, 96) if ((nose_x-cx)**2/rx**2 + (nose_y-cy)**2/ry**2) <= 1 else (43, 75, 255)
                if self.is_recording: self.lip_activity.append(d)
                cv2.ellipse(frame, (cx, cy), (rx, ry), 0, 0, 360, color_oval, 2, cv2.LINE_AA)
        qi = QImage(frame.data, w_f, h_f, w_f * 3, QImage.Format.Format_BGR888)
        self.v_lbl.setPixmap(QPixmap.fromImage(qi).scaled(self.v_lbl.size(), Qt.AspectRatioMode.KeepAspectRatioByExpanding))

    def toggle_rec(self):
        if self.rec_btn.isChecked():
            self.is_recording = True; self.rec_btn.setText("ТОҚТАТУ"); self.save_btn.hide()
            self.audio_data, self.lip_activity = [], []; self.score_ui.set_score(0)
            self.stream = sd.InputStream(samplerate=16000, channels=1, callback=self.audio_callback); self.stream.start()
        else:
            self.is_recording = False; self.rec_btn.setText("ЖАЗУДЫ БАСТАУ")
            if hasattr(self, 'stream'): self.stream.stop(); self.stream.close()
            self.calculate()

    def calculate(self):
        audio_score = 0.0
        if self.models_loaded and len(self.audio_data) > 800:
            try:
                arr = np.array(self.audio_data, dtype=np.float32)
                energy = np.abs(arr)
                mask = energy > (np.max(energy) * 0.1)
                if np.any(mask):
                    arr = arr[np.argmax(mask) : len(mask) - np.argmax(mask[::-1])]
                if len(arr) > 400:
                    arr = arr / (np.sqrt(np.mean(arr**2)) + 1e-9) * 0.1
                    inp = self.processor(arr, sampling_rate=16000, return_tensors="pt")
                    with torch.no_grad():
                        e = self.wav2vec(**inp).last_hidden_state.mean(dim=1).numpy().flatten()
                    probs = self.clf_audio.predict_proba([e])[0]
                    target_idx = self.box.currentIndex()
                    audio_score = min(1.0, probs[target_idx] * 2.0)
                    if np.argmax(probs) == target_idx:
                        audio_score = max(audio_score, 0.93)
            except: pass

        if not self.models_loaded: 
            audio_score = min(0.9, np.max(np.abs(self.audio_data)) * 5) if self.audio_data else 0

        lip_avg = np.mean(self.lip_activity) if self.lip_activity else 0
        target = TARGET_MOUTH_OPENNESS.get(self.box.currentText(), 0.03)
        lip_score = max(0, 1 - abs(lip_avg - target) / 0.07)

        if self.box.currentText() == "Ә" and lip_avg < 0.045:
            audio_score *= 0.5

        
        final = 0 if audio_score < 0.05 else (audio_score * 0.85 + lip_score * 0.15) * 100
        
        # --- ЛОГИКА ПЛАВНОГО БОНУСА (35-60%) ---
        if 35 <= final <= 60:
            # Масштабируем диапазон 35-60 в 0-1 (t)
            t = (final - 35) / (60 - 35)
            # Кривая «колокол»: плавно растет к середине и падает к краям
            # Используем синус для мягкости: sin(pi * t) дает 0 в 35, 1 в середине и 0 в 60
            multiplier = np.sin(np.pi * t)
            final += 25 * multiplier
        
        self.last_final_score = int(max(0, min(100, final)))
        
        self.anim = QVariantAnimation(self)
        self.anim.setDuration(1800)
        self.anim.setStartValue(0.0)
        self.anim.setEndValue(float(self.last_final_score))
        self.anim.setEasingCurve(QEasingCurve.Type.OutCubic)
        self.anim.valueChanged.connect(self.score_ui.set_score)
        self.anim.start()
        
        self.anim.finished.connect(lambda: self.save_btn.show() if self.last_final_score > 5 else None)
        self.save_btn.setText("НӘТИЖЕНІ САҚТАУ"); self.save_btn.setEnabled(True)

    def closeEvent(self, event):
        self.thread.stop()
        event.accept()

